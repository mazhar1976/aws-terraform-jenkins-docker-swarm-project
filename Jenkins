pipeline {
    agent any

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out InventoryHub source code'
                checkout scm
            }
        }

        stage('Check Node.js') {
            steps {
                sh '''
                    node --version
                    npm --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh 'npm test'
            }
        }
       
        stage('SonarQube Code Analysis') {
 	    steps {
        	script {
            	    def scannerHome = tool 'SonarScanner'

            	    withSonarQubeEnv('SonarQube') {
                        sh "${scannerHome}/bin/sonar-scanner"
                    }
                }
            }
        } 

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t inventoryhub:latest .'
            }
        }
  
        stage('Trivy Security Scan') {
 	    steps {
          	sh '''
            	   echo "Scanning InventoryHub Docker image..."

            	   trivy --config "" image \
                     --scanners vuln \
                     --ignorefile /dev/null \
                     --severity HIGH,CRITICAL \
                     --exit-code 0 \
                     --no-progress \
                     inventoryhub:latest

                   echo "Checking for CRITICAL vulnerabilities..."

                   trivy --config "" image \
                     --scanners vuln \
                     --ignorefile /dev/null \
                     --severity CRITICAL \
                     --exit-code 1 \
                     --no-progress \
                     inventoryhub:latest
                '''
            }
        }
    }
    
    post {
        success {
            echo 'InventoryHub CI pipeline completed successfully!'
        }

        failure {
            echo 'InventoryHub CI pipeline failed. Check the console output.'
        }
    }
}

